# Ignore local interactive HTML dashboard
camera_app_ideas.html

# Ignore images & graphic assets
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.svg

# Ignore environment variables, secrets, keys & credentials
.env
.env.*
secrets.env
secrets.txt
.git-credentials
*.pem
*.key
*.crt
*.p12

# Ignore OS & IDE temp files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.tmp

# Ignore Python build & cache files
__pycache__/
*.py[cod]
*$py.class
*.db
*.sqlite3

# Ignore external review & incoming contribution folders (push deny list)
external_contributions/
community_reviews/
test_bench_build/


